// newtype
typ Str = Byte.Ptr

// alias
typ BytePtr = alias Byte.Ptr

typ Opt(T) = (
    None,
    Some = T,
)

fun [Opt(T)] replace (self: Self, new: S) -> Opt(S) = match self {
    None => Opt:None,
    Some(_) => Opt:Some(new),
}

typ Person = (
    name: Str,
    var age: Nat,
)

fun [Person] born (name: Str) -> Person = Person(
    name: name,
    age: 0,
)

fun [Person] say_hello (self: Self.Ptr) = {
    print("Hello, I am ");
    println(self.deref:name);
}

fun main = {
    val x: Opt(Nat) = Opt:None;
    val y: Opt(Nat) = Opt:Some(42);

    var joe := Person(
        name: "Joe",
        age: 42,
    );

    joe.say_hello;
    joe:age += 1;

    val baby_joe := Person:born("Baby Joe");
    baby_joe.say_hello;
}
